{
  "manifest_version": 3,
  "name": "Worldwide Radio",
  "version": "1.1.0",
  "description": "Browse public radio stations from Radio Browser and save favorites.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://de1.api.radio-browser.info/*",
    "https://*.api.radio-browser.info/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Worldwide Radio",
    "default_popup": "popup.html"
  }
}
